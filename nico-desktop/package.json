{
  "name": "nico-desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for Nico",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --check main.js && node --check preload.js",
    "dist": "electron-builder --win",
    "dist-dir": "electron-builder --win dir"
  },
  "keywords": [
    "nico",
    "electron",
    "desktop"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.nico.os",
    "productName": "Nico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis", "dir"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Nico"
    }
  }
}
