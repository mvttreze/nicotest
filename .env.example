GROQ_API_KEY=your_groq_api_key_here
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_HEAVY_MODEL=openai/gpt-oss-120b
# Optional owner-only default; falls back to GROQ_HEAVY_MODEL.
GROQ_OWNER_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
# Optional chat fallback. Gemini's free tier may use prompts to improve Google products.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_CHAT_FALLBACK_ENABLED=false
# Optional free fallback. OpenRouter free models have shared account limits
# and model-provider data policies vary. Keep this as a last fallback.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openrouter/free
# Optional OpenCode Console integration for eligible external API models.
# Leave model lists blank unless you have an API-accessible model configured.
# Free OpenCode models are limited to OpenCode and return 403 to other apps.
OPENCODE_API_KEY=
OPENCODE_MODELS=
OPENCODE_OWNER_MODELS=
OPENCODE_CHAT_COMPLETIONS_URL=https://opencode.ai/inference/openai/v1/chat/completions
# FreeLLMAPI gateway (optional). Base URL has no /v1 suffix.
# Local backend: FREELLMAPI_BASE_URL=http://localhost:3001
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=your_freellmapi_unified_key_here
FREELLMAPI_CHAT_MODEL=auto
FREELLMAPI_IMAGE_MODEL=auto
HF_TOKEN=your_huggingface_token_here
# HF_KEY is accepted as an alias.
# Token needs the "Make calls to Inference Providers" permission.
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
HF_SPACE=black-forest-labs/FLUX.1-schnell
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
CREATOR_NAME=Matt Andrei Crisostomo
CREATOR_HOBBIES=List hobbies here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
ADMIN_LOGIN=admin
ADMIN_EMAIL=your_real_supabase_email@example.com
ADMIN_PASSWORD=your_unique_admin_password_here
ALLOW_DEMO_AUTH=true
